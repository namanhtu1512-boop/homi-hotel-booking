<mxGeometry x="195.0" y="40" width="30" height="30" as="geometry" />
</mxCell>
<mxCell id="d8_p_2" value="Customer gửi yêu cầu nhận phòng sớm hoặc&#10;trả phòng muộn từ đơn của mình&#10;(kèm giờ mong muốn, lý do)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="110" width="300" height="108" as="geometry" />
</mxCell>
<mxCell id="d8_p_3" value="Tạo early_checkin_requests /&#10;late_checkout_requests (status = pending)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="258" width="300" height="84" as="geometry" />
</mxCell>
<mxCell id="d8_d_4" value="Staff/Admin duyệt?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
<mxGeometry x="40.0" y="382" width="340" height="90" as="geometry" />
</mxCell>
<mxCell id="d8_p_5" value="Từ chối: cập nhật status = rejected,&#10;ghi staff_note" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="512" width="300" height="84" as="geometry" />
</mxCell>
<mxCell id="d8_p_6" value="Duyệt: cập nhật status = approved,&#10;ghi handled_by/handled_at.&#10;Tính phí — nhận phòng sớm: 100.000đ/giờ&#10;(tối đa 3 giờ); trả phòng muộn: 100k/200k/&#10;300k hoặc 50%/100% giá đêm cuối tuỳ giờ trễ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="636" width="300" height="156" as="geometry" />
</mxCell>
<mxCell id="d8_note_7" value="Lưu ý: ngoài luồng yêu cầu này còn&#10;1 cơ chế phụ thu nhận phòng sớm&#10;TỰ ĐỘNG riêng biệt&#10;(hotel_info.early_checkin_surcharge_percent),&#10;áp dụng thẳng khi check-in,&#10;không qua duyệt." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontStyle=2;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
<mxGeometry x="400" y="626" width="280" height="110" as="geometry" />
</mxCell>
<mxCell id="d8_p_8" value="Ghi phí vào incidental_invoice_items&#10;(type = surcharge) qua IncidentalInvoiceService&#10;— KHÔNG dùng payments.surcharge_amount&#10;(trường cũ đã ngưng dùng)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="832" width="300" height="132" as="geometry" />
</mxCell>
