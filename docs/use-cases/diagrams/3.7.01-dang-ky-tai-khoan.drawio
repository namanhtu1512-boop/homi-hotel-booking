<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram id="dang-ky-tai-khoan" name="Đăng ký tài khoản">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title1" value="Sơ đồ hoạt động: Đăng ký tài khoản" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="780" height="30" as="geometry" />
        </mxCell>

        <!-- Lanes -->
        <mxCell id="lane1" value="Khách hàng" style="swimlane;whiteSpace=wrap;html=1;startSize=30;horizontal=1;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;container=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="900" as="geometry" />
        </mxCell>
        <mxCell id="lane2" value="Hệ thống" style="swimlane;whiteSpace=wrap;html=1;startSize=30;horizontal=1;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;container=0;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="480" height="900" as="geometry" />
        </mxCell>

        <!-- Start -->
        <mxCell id="start1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="175" y="90" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Nhập thông tin -->
        <mxCell id="procInput" value="Truy cập /customer/register&#10;Nhập họ tên, email, số điện thoại,&#10;mật khẩu và xác nhận mật khẩu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="90" y="160" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Decision 1: validate -->
        <mxCell id="dec1" value="Dữ liệu hợp lệ?&#10;(đủ trường bắt buộc, đúng định dạng email,&#10;mật khẩu ≥ 8 ký tự và khớp nhau)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="350" y="150" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- Error 1 -->
        <mxCell id="err1" value="Báo lỗi validate&#10;(thiếu trường / sai định dạng /&#10;mật khẩu xác nhận không khớp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="610" y="165" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Decision 2: email exists -->
        <mxCell id="dec2" value="Email đã tồn tại&#10;trong hệ thống?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="350" y="300" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Error 2 -->
        <mxCell id="err2" value="Thông báo email đã được sử dụng&#10;Gợi ý đăng nhập hoặc quên mật khẩu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="610" y="310" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Hash password -->
