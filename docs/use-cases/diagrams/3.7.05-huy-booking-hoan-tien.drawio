<mxGeometry x="60.0" y="155" width="300" height="82" as="geometry" />
</mxCell>
<mxCell id="b3_v_3" value="Người thực hiện huỷ là ai?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
<mxGeometry x="385.0" y="272" width="410" height="90" as="geometry" />
</mxCell>
<mxCell id="b3_v_4" value="Khách hàng tự huỷ — áp phí theo giờ&#10;còn lại đến check-in: ≥48h: 0% ·&#10;24–48h: 30% · 12–24h: 50% · &lt;12h: 100%&#10;(BookingService::cancelByCustomer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60" y="397" width="300" height="126" as="geometry" />
</mxCell>
<mxCell id="b3_v_5" value="Nhân viên/Admin huỷ — không áp bậc&#10;phí, mặc định hoàn toàn bộ&#10;(BookingService::cancelByAdmin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="400" y="397" width="300" height="104" as="geometry" />
</mxCell>
<mxCell id="b3_v_6" value="Cập nhật booking = cancelled, ghi&#10;booking_status_logs, gửi thông báo cho khách" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="400.0" y="558" width="380" height="82" as="geometry" />
</mxCell>
<mxCell id="b3_v_7" value="Đã thu tiền &amp; còn số&#10;tiền cần hoàn?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
<mxGeometry x="385.0" y="675" width="410" height="116" as="geometry" />
</mxCell>
<mxCell id="b3_v_8" value="Không qua VNPay: đánh dấu&#10;payment = refunded (tiền mặt/&#10;chuyển khoản — nhân viên hoàn thủ công)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="400" y="826" width="180" height="104" as="geometry" />
</mxCell>
<mxCell id="b3_v_9" value="Qua VNPay: gọi VNPayService::refund()&#10;(API thật, ký HMAC) — thành công →&#10;payment=refunded; thất bại (code≠00) →&#10;cần nhân viên xử lý thủ công" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
