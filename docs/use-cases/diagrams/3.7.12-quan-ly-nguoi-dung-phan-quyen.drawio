<mxCell id="d5_p_3" value="Xem danh sách người dùng, lọc theo role&#10;(customer/staff/admin) — vai trò KHÔNG&#10;chỉnh sửa được ở màn hình này" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
