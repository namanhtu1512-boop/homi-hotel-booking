</mxCell>
<mxCell id="d5_p_4" value="Chọn 1 tài khoản, bấm đổi trạng thái&#10;(PATCH toggle-status — chung 1 API cho&#10;cả khoá và mở khoá)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="358" width="300" height="108" as="geometry" />
</mxCell>
