<mxGeometry x="215.0" y="40" width="30" height="30" as="geometry" />
</mxCell>
<mxCell id="bd_p_2" value="Khách chọn ngày check-in/check-out,&#10;số lượng khách, loại phòng" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="110" width="340" height="84" as="geometry" />
</mxCell>
<mxCell id="bd_d_3" value="AvailabilityService còn phòng trống&#10;trong khoảng ngày?&#10;(total_rooms − (đã đặt + đang giữ chỗ))" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
<mxGeometry x="40.0" y="234" width="380" height="146" as="geometry" />
</mxCell>
<mxCell id="bd_p_4" value="Báo hết phòng&#10;(không có gợi ý loại phòng khác)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="420" width="340" height="84" as="geometry" />
</mxCell>
<mxCell id="bd_p_5" value="Tạo room_hold tạm thời cho phiên&#10;(giữ chỗ 15 phút — RoomHoldService)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="420" width="340" height="84" as="geometry" />
</mxCell>
<mxCell id="bd_d_6" value="Đã đăng nhập là Customer?&#10;(chặn ngay tại route bởi middleware&#10;auth+role:customer)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
<mxGeometry x="40.0" y="604" width="380" height="146" as="geometry" />
</mxCell>
<mxCell id="bd_p_7" value="Yêu cầu đăng nhập / đăng ký&#10;(rồi quay lại bước này)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="790" width="340" height="84" as="geometry" />
</mxCell>
<mxCell id="bd_p_8" value="Điền thông tin đặt phòng, chọn khuyến mãi,&#10;xem tạm tính (PricingService)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="790" width="340" height="84" as="geometry" />
</mxCell>
<mxCell id="bd_p_9" value="Mở DB transaction, lockForUpdate&#10;trên room_types" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="974" width="340" height="84" as="geometry" />
</mxCell>
<mxCell id="bd_d_10" value="Kiểm tra lại phòng trống&#10;trong transaction?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
<mxGeometry x="40.0" y="1098" width="380" height="118" as="geometry" />
</mxCell>
<mxCell id="bd_p_11" value="Rollback transaction,&#10;báo hết phòng — không tạo đơn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="1256" width="340" height="84" as="geometry" />
</mxCell>
<mxCell id="bd_p_12" value="Ghi bookings (status=pending_deposit,&#10;booking_code=HOMI-...) + booking_items +&#10;payment (status=unpaid), commit; giải&#10;phóng room_hold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="1256" width="340" height="132" as="geometry" />
</mxCell>
<mxCell id="bd_p_13" value="Gửi thông báo cho khách &amp; nhân viên,&#10;hiển thị mã đơn (booking_code)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="1440" width="340" height="84" as="geometry" />
</mxCell>
<mxCell id="bd_d_14" value="Khách thanh toán bằng&#10;phương thức nào?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
<mxGeometry x="30.0" y="1564" width="400" height="118" as="geometry" />
</mxCell>
<mxCell id="bd_p_15" value="VNPay: cổng thanh toán thật gọi về&#10;(IPN/return) → payment=paid,&#10;booking=confirmed TỰ ĐỘNG&#10;(confirmAfterPayment)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="1722" width="220" height="126" as="geometry" />
</mxCell>
<mxCell id="bd_p_16" value="Đặt cọc 30% (demo, không gọi&#10;cổng thật): payDepositDemo() →&#10;booking=confirmed TỰ ĐỘNG" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="120.0" y="1722" width="220" height="104" as="geometry" />
</mxCell>
<mxCell id="bd_p_17" value="Chuyển khoản: khách tự báo đã&#10;chuyển → booking=pending; nhân viên&#10;đối soát, đánh dấu payment=paid,&#10;rồi PHẢI bấm xác nhận đơn thủ công&#10;(confirm(): pending → confirmed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="180.0" y="1722" width="220" height="148" as="geometry" />
</mxCell>
<mxCell id="bd_p_18" value="Ghi booking_status_logs ở mỗi bước&#10;chuyển trạng thái, gửi thông báo cho khách&#10;(BookingStatusChanged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="1910" width="340" height="108" as="geometry" />
