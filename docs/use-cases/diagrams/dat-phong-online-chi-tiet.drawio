<mxCell id="bd_title" value="Sơ đồ hoạt động chi tiết: Đặt phòng online &amp; xác nhận thanh toán" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
