</mxCell>
<mxCell id="g22_v_5" value="Không: hệ thống tự kiểm tra phòng hiện&#10;tại còn trống trong khoảng ngày mới&#10;không (needs_switch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
