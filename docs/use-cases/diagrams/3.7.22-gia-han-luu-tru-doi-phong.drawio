<mxCell id="g22_v_2" value="Mở đơn đang lưu trú (status=checked_in),&#10;chọn &quot;Gia hạn lưu trú&quot;, nhập ngày&#10;check-out mới" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="155" width="300" height="104" as="geometry" />
</mxCell>
<mxCell id="g22_v_3" value="computeExtension(): validate ngày mới &gt;&#10;ngày check-out hiện tại" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="400.0" y="294" width="380" height="82" as="geometry" />
