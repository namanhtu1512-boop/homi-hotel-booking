<mxGeometry x="385.0" y="727" width="410" height="142" as="geometry" />
</mxCell>
<mxCell id="g22_v_7" value="Lọc phương án đổi phòng: sức chứa ≥&#10;người lớn (cứng) + extraBedsNeeded()&#10;≤ 1 giường &amp; còn giường phụ trong kho&#10;(đã sửa — trước đây chỉ đề xuất được&#10;Family)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
