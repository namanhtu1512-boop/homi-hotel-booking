</mxCell>
<mxCell id="b9_v_2" value="Khách (đã đăng nhập, role=customer) điền&#10;form tại /group-bookings: công ty, người&#10;liên hệ, sđt, email, số người, số phòng,&#10;ngày, loại phòng mong muốn, ghi chú" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="155" width="260" height="126" as="geometry" />
</mxCell>
<mxCell id="b9_v_3" value="Lưu group_booking_requests (status=new),&#10;gửi THÔNG BÁO TRONG HỆ THỐNG cho&#10;admin/staff (in-app, không phải email)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="680.0" y="316" width="320" height="104" as="geometry" />
</mxCell>
<mxCell id="b9_v_4" value="Nhân viên HOẶC Admin xem yêu cầu,&#10;liên hệ khách qua chat nội bộ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="360.0" y="455" width="280" height="82" as="geometry" />
</mxCell>
<mxCell id="b9_v_5" value="Tính báo giá: tự động áp ưu đãi theo bậc số&#10;phòng (group_discount_policies); có thể đề&#10;xuất thêm ưu đãi ngoài bậc, cần Admin duyệt&#10;nếu vượt trần tự quyết (xem chi tiết Hình 3.7.25)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="680.0" y="572" width="320" height="126" as="geometry" />
</mxCell>
<mxCell id="b9_v_6" value="Gửi báo giá: qua khung chat nội bộ&#10;VÀ email (Mail::GroupBookingQuoteMail)&#10;cho khách" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="360.0" y="733" width="280" height="104" as="geometry" />
</mxCell>
<mxCell id="b9_v_7" value="Tự động chuyển status=contacted&#10;khi gửi báo giá" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="680.0" y="872" width="320" height="82" as="geometry" />
</mxCell>
<mxCell id="b9_v_8" value="Khách đồng ý &amp; Nhân viên/Admin&#10;tạo booking chính thức?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
<mxGeometry x="345.0" y="989" width="310" height="116" as="geometry" />
</mxCell>
<mxCell id="b9_v_9" value="LƯU Ý: không có trạng thái đóng/từ&#10;chối thật sự — yêu cầu dừng lại ở&#10;&quot;contacted&quot;, không có hành động tiếp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="360.0" y="1140" width="280" height="104" as="geometry" />
