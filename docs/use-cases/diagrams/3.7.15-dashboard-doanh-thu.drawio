<mxGeometry x="45.0" y="294" width="330" height="90" as="geometry" />
</mxCell>
<mxCell id="b6_v_4" value="DashboardService (cơ bản — CẢ 2 vai trò):&#10;stats() (số booking theo trạng thái, tỷ lệ huỷ),&#10;recentBookings(5), revenueByMonth(6 tháng&#10;cố định), occupancyRate() (hôm nay)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="400.0" y="419" width="420" height="126" as="geometry" />
</mxCell>
<mxCell id="b6_v_5" value="Hiển thị dashboard cơ bản (Chart.js):&#10;biểu đồ đường doanh thu 6 tháng,&#10;biểu đồ tròn tỷ lệ lấp đầy, bảng 5 đơn gần nhất" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="580" width="300" height="104" as="geometry" />
</mxCell>
<mxCell id="b6_v_6" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1">
<mxGeometry x="195.0" y="719" width="30" height="30" as="geometry" />
</mxCell>
<mxCell id="b6_v_7" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1">
<mxGeometry x="201.0" y="725" width="18" height="18" as="geometry" />
</mxCell>
<mxCell id="b6_v_8" value="Admin — DashboardService (mở rộng), 5 nhánh mới:&#10;• bookingsRevenueByPeriod(): doanh thu theo kỳ chọn&#10;  được (ngày/tháng/năm — KHÔNG có tuần; tự nới rộng&#10;  granularity nếu khoảng ngày dài: &gt;92 ngày→tháng,&#10;  &gt;730 ngày→năm)&#10;• occupancyForRange() + occupancyByRoomType(): công&#10;  suất phòng theo khoảng ngày tuỳ chọn, lọc theo loại phòng&#10;• stayDurationStats(): thời gian lưu trú trung bình,&#10;  tỷ lệ ở ngắn (≤2 đêm) / dài (≥3 đêm)&#10;• roomTypeStats(): số đơn, số phòng đã đặt, doanh thu&#10;  theo từng loại phòng&#10;• amenityStats(): số loại phòng có từng tiện nghi&#10;  (Amenity::withCount)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="400" y="580" width="420" height="300" as="geometry" />
</mxCell>
<mxCell id="b6_v_9" value="Hiển thị dashboard đầy đủ (Chart.js): thêm&#10;biểu đồ doanh thu theo kỳ, công suất theo loại&#10;phòng, biểu đồ thời lượng lưu trú, bảng loại&#10;phòng, biểu đồ tiện nghi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="915" width="300" height="126" as="geometry" />
</mxCell>
