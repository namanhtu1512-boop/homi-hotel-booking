<mxCell id="b6_v_2" value="Admin hoặc Nhân viên truy cập trang&#10;Dashboard (/admin/dashboard hoặc&#10;/staff/dashboard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=20;" vertex="1" parent="1">
<mxGeometry x="60.0" y="155" width="300" height="104" as="geometry" />
</mxCell>
