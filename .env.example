APP_NAME=Homi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Nếu chạy bằng `php artisan serve` thì giữ nguyên; nếu dùng vhost Laragon
# (http://<ten-thu-muc-project>.test) thì đổi lại cho khớp.
APP_URL=http://127.0.0.1:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Đăng ký tài khoản test miễn phí tại https://sandbox.vnpayment.vn/devreg
# để lấy TMN Code + Hash Secret bên dưới.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# Phiên thanh toán VNPay tối đa bao nhiêu phút kể từ lúc khách bấm "Thanh
# toán VNPay" — không bao giờ vượt quá hạn giữ chỗ hiện tại (xem services.vnpay).
VNPAY_TXN_EXPIRE_MINUTES=15
# Khoảng đệm (phút) giữ phòng thêm sau khi hold hết hạn, trước khi hủy hẳn
# và nhả phòng — chờ bù trễ IPN/return VNPay (services.booking.expired_grace_minutes).
BOOKING_EXPIRED_GRACE_MINUTES=5

# Đăng nhập Facebook/Google — tạo app tại
# https://developers.facebook.com/apps và https://console.cloud.google.com/apis/credentials,
# khai báo Redirect URI đúng bằng các URL *_REDIRECT_URI bên dưới.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

VITE_APP_NAME="${APP_NAME}"

# Trợ lý ảo (Gemini API, có gói miễn phí) — cần API key thật từ
# https://aistudio.google.com/apikey để widget chat AI hoạt động. Bỏ trống
# thì widget vẫn hiện nhưng sẽ báo "chưa cấu hình" thay vì lỗi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
